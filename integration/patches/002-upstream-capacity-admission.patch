+fn context_capacity_failure(
+    rejection: context_budget::ContextCapacityRejection,
+    owner_exists: bool,
+) -> ConversationLoopFailure {
+    if owner_exists {
+        ConversationLoopFailure::CloseHealthy(Box::new(rejection))
+    } else {
+        ConversationLoopFailure::Cancel(Box::new(rejection))
+    }
+}
+
+fn context_capacity_rejection_receipt(
+    rejection: context_budget::ContextCapacityRejection,
+    owner_was_live: bool,
+) -> String {
+    let stage = if owner_was_live {
+        "pre-append"
+    } else {
+        "pre-owner"
+    };
+    format!(
+        "FAST_CONVERSATION_REJECTION schema={} kind={} stage={stage} owner_was_live={owner_was_live} owner_mutated=false input_tokens={} requested_output_tokens={} reserved_output_tokens={} usable_input_limit={} owner_positions={} required_positions={} overflow_positions={}",
+        rejection.schema,
+        rejection.kind.as_str(),
+        rejection.input_tokens,
+        rejection.requested_output_tokens,
+        rejection.reserved_output_tokens,
+        rejection.usable_input_limit,
+        rejection.owner_positions,
+        rejection.required_positions,
+        rejection.overflow_positions,
+    )
+}
+
+fn long_context_admission_rejection_receipt(
+    miss: RequestMlaLongContextAdmissionMiss,
+    owner_was_live: bool,
+) -> String {
+    match miss.account() {
+        Some(account) => format!(
+            "FAST_CONVERSATION_REJECTION schema={} kind={} stage=pre-kv-allocation owner_was_live={owner_was_live} owner_mutated=false account_schema={} total_device_bytes={} free_device_bytes={} resident_live_device_bytes={} active_kv8_bytes={} packed_snapshot_bytes={} fresh_destination_bytes={} request_workspace_reserve_bytes={} safety_reserve_bytes={} required_additional_bytes={} projected_peak_bytes={} remaining_free_bytes={} shortfall_bytes={}",
+            REQUEST_MLA_LONG_CONTEXT_ADMISSION_MISS_SCHEMA,
+            miss.kind(),
+            account.schema,
+            account.total_device_bytes,
+            account.free_device_bytes,
+            account.resident_live_device_bytes,
+            account.active_kv8_bytes,
+            account.packed_snapshot_bytes,
+            account.fresh_destination_bytes,
+            account.request_workspace_reserve_bytes,
+            account.safety_reserve_bytes,
+            account.required_additional_bytes,
+            account.projected_peak_bytes,
+            account.remaining_free_bytes,
+            account.shortfall_bytes,
+        ),
+        None => match miss.memory_snapshot() {
+            Some((free_device_bytes, total_device_bytes)) => format!(
+                "FAST_CONVERSATION_REJECTION schema={} kind={} stage=pre-kv-allocation owner_was_live={owner_was_live} owner_mutated=false account_schema=none total_device_bytes={total_device_bytes} free_device_bytes={free_device_bytes}",
+                REQUEST_MLA_LONG_CONTEXT_ADMISSION_MISS_SCHEMA,
+                miss.kind(),
+            ),
+            None => format!(
+                "FAST_CONVERSATION_REJECTION schema={} kind={} stage=pre-kv-allocation owner_was_live={owner_was_live} owner_mutated=false account_schema=none",
+                REQUEST_MLA_LONG_CONTEXT_ADMISSION_MISS_SCHEMA,
+                miss.kind(),
+            ),
+        },
+    }
+}
+
+fn conversation_rejection_receipt(
+    error: &(dyn std::error::Error + 'static),
+    owner_was_live: bool,
+) -> Option<String> {
+    if let Some(rejection) = error.downcast_ref::<context_budget::ContextCapacityRejection>() {
+        return Some(context_capacity_rejection_receipt(
+            *rejection,
+            owner_was_live,
+        ));
+    }
+    error
+        .downcast_ref::<RequestMlaStartError>()
+        .and_then(RequestMlaStartError::long_context_admission_miss)
+        .map(|miss| long_context_admission_rejection_receipt(miss, owner_was_live))
+}
