+impl RequestMlaStartError {
+    /// Preserve the structured long-context admission miss across the session
+    /// construction and lease-cleanup boundary. Product callers use this to
+    /// publish the exact pre-allocation memory account without parsing Debug.
+    pub fn long_context_admission_miss(&self) -> Option<RequestMlaLongContextAdmissionMiss> {
+        let construction: &RequestMlaSessionError = match self {
+            Self::Session(construction) => construction,
+            Self::ConstructionDrain { construction, .. }
+            | Self::ConstructionCleanup { construction, .. } => construction.as_ref(),
+            Self::Admission(_) | Self::RuntimeProfile { .. } | Self::StreamIdentity(_) => {
+                return None;
+            }
+        };
+        match construction {
+            RequestMlaSessionError::Execution(M216ExecutionError::RequestMlaOwner(
+                RequestMlaOwnerError::AdmissionMiss(miss),
+            )) => Some(*miss),
+            _ => None,
+        }
+    }
+}
+
+#[cfg(test)]
+mod request_mla_start_error_tests {
+    use super::*;
+    use crate::request_mla_long_context_admission;
+
+    fn session_error_with_admission_miss(
+        miss: RequestMlaLongContextAdmissionMiss,
+    ) -> RequestMlaSessionError {
+        RequestMlaSessionError::Execution(M216ExecutionError::RequestMlaOwner(
+            RequestMlaOwnerError::AdmissionMiss(miss),
+        ))
+    }
+
+    #[test]
+    fn long_context_admission_miss_survives_the_session_start_error_chain() {
+        let total = 32 * 1_024 * 1_024 * 1_024_u64;
+        let miss = request_mla_long_context_admission(total, total, false).unwrap_err();
+        let admission = BoundedSessionAdmission::new(1).unwrap();
+        let mut lease = admission.try_admit(RequestKey::new(1, 1).unwrap()).unwrap();
+        let admission_identity = lease.identity();
+        lease.close(SessionOutcome::Failed).unwrap();
+
+        let errors = [
+            RequestMlaStartError::Session(session_error_with_admission_miss(miss)),
+            RequestMlaStartError::ConstructionDrain {
+                construction: Box::new(session_error_with_admission_miss(miss)),
+                drain: CudaRuntimeError::invalid_metadata("long_context_admission_test_drain"),
+                admission_identity,
+            },
+            RequestMlaStartError::ConstructionCleanup {
+                construction: Box::new(session_error_with_admission_miss(miss)),
+                admission: SessionAdmissionError::ZeroCapacity,
+                admission_identity,
+            },
+        ];
+        for error in errors {
+            assert_eq!(error.long_context_admission_miss(), Some(miss));
+        }
+    }
+}
