+    #[test]
+    fn ordinary_chat_archive_reencode_preserves_two_turn_byte_prefix() {
+        let root = std::env::temp_dir().join(format!(
+            "cq-infer-chat-prefix-{}-{}",
+            std::process::id(),
+            SystemTime::now()
+                .duration_since(UNIX_EPOCH)
+                .unwrap()
+                .as_nanos()
+        ));
+        fs::create_dir(&root).unwrap();
+        let (mut memory, resumed) = conversation_memory::ActiveConversationMemory::open(
+            &root,
+            conversation_memory::ResumeSelection::New,
+            conversation_memory::MemoryConfig::default(),
+        )
+        .unwrap();
+        assert!(!resumed);
+
+        memory
+            .append_user("Reply with the single word OK.".to_string())
+            .unwrap();
+        let first_document = serde_json::to_vec(&memory.active_values("").unwrap()).unwrap();
+        let first_prompt =
+            encode_dsv4_messages_v2(&first_document, Dsv4EncodingOptionsV2::chat()).unwrap();
+        assert!(!first_prompt.contains("Host execution environment"));
+        assert!(!first_prompt.contains("shell=powershell"));
+
+        memory.append_assistant("OK.".to_string()).unwrap();
+        let committed_document = serde_json::to_vec(&memory.active_values("").unwrap()).unwrap();
+        let committed_prompt =
+            encode_dsv4_messages_v2(&committed_document, Dsv4EncodingOptionsV2::chat()).unwrap();
+        let committed_suffix = format!("OK.{M114_EOS}");
+        assert_eq!(
+            committed_prompt.strip_prefix(&first_prompt),
+            Some(committed_suffix.as_str())
+        );
+
+        memory
+            .append_user("Reply with the single word YES.".to_string())
+            .unwrap();
+        let second_document = serde_json::to_vec(&memory.active_values("").unwrap()).unwrap();
+        let second_prompt =
+            encode_dsv4_messages_v2(&second_document, Dsv4EncodingOptionsV2::chat()).unwrap();
+        assert_eq!(
+            &second_prompt.as_bytes()[..committed_prompt.len()],
+            committed_prompt.as_bytes()
+        );
+        assert_eq!(
+            second_prompt.strip_prefix(&committed_prompt),
+            Some("<｜User｜>Reply with the single word YES.<｜Assistant｜></think>")
+        );
+
+        drop(memory);
+        assert!(root.starts_with(std::env::temp_dir()));
+        fs::remove_dir_all(root).unwrap();
+    }
