p0-prefill-v37-m1024-q8-fast-union = [
    "p0-prefill-v36-m1024-layer-union-whole-ffn",
    "cq-model-deepseek-v4-flash-runtime/p0-prefill-v37-m1024-q8-fast-union",
]
cache4-v34-packed-prefix = [
    "p0-prefill-v34-q8-quantize-shard4",
    "cq-model-deepseek-v4-flash-runtime/cache4-v34-packed-prefix",
]
cache4-v34-packed-prefix-v2 = [
    "cache4-v34-packed-prefix",
    "cq-model-deepseek-v4-flash-runtime/cache4-v34-packed-prefix-v2",
]
cache4-v34-agent-prefix-b16-v3 = [
    "cache4-v34-packed-prefix-v2",
    "cq-model-deepseek-v4-flash-runtime/cache4-v34-agent-prefix-b16-v3",
]
dspark-target-verify-device-profile = [
    "dspark-product",
    "cq-model-deepseek-v4-flash-runtime/dspark-target-verify-device-profile",
]

[dependencies]
cq-backend = { path = "../cq-backend", features = ["cuda"] }
cq-generation = { path = "../cq-generation" }
cq-model-deepseek-v4-flash = { path = "../cq-model-deepseek-v4-flash" }
cq-model-deepseek-v4-flash-runtime = { path = "../cq-model-deepseek-v4-flash-runtime", features = [
    "single-sequence-fast",
] }
cq-runtime = { path = "../cq-runtime" }
crossterm = "0.28.1"
serde = { version = "1.0.228", features = ["derive"] }
serde_json = "1.0.150"
sha2 = "0.10.9"
signal-hook = "0.3.18"
unicode-width = "0.2.2"

[target.'cfg(unix)'.dependencies]
libc = "0.2"

[target.'cfg(windows)'.dependencies]
windows-sys = { version = "0.61.2", features = [
    "Win32_Foundation",
    "Win32_Security",
    "Win32_System_JobObjects",
    "Win32_System_Threading",
] }

[[bin]]
name = "cq-infer"
path = "src/main.rs"
