    "ctx6r-ratio4-two-level-candidate",
    "ctx6r-token-paced-capability-receipt",
]
# Public product closure owns the qualified CTX12 attention path. The full
# routed FFN width and route-fused topology are selected by toc-sm70-v1 below.
toc-sm70-core-v1 = [
    "ctx12-ratio128-skip-row-validation-candidate",
    "kv8-dsa-prefix-snapshot",
]
fast-route-quantize-fused-v1-candidate = [
    "fast-expert-word-pack-v1",
    "cq-model-deepseek-v4-flash-runtime/fast-route-quantize-fused-v1-candidate",
]
fast-route-quantize-fused-v1 = [
    "fast-route-quantize-fused-v1-candidate",
    "cq-model-deepseek-v4-flash-runtime/fast-route-quantize-fused-v1",
]
fast-cv-host-profile = [
    "fast-route-quantize-fused-v1-candidate",
    "cq-model-deepseek-v4-flash-runtime/fast-cv-host-profile",
]
fast-cv-schedule-spin-candidate = [
    "fast-route-quantize-fused-v1-candidate",
    "cq-model-deepseek-v4-flash-runtime/fast-cuda-schedule-spin-candidate",
]
fast-cv-ratio4-pacing-candidate = [
    "fast-route-quantize-fused-v1-candidate",
    "cq-model-deepseek-v4-flash-runtime/fast-cv-ratio4-pacing-candidate",
