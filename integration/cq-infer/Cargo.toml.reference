fast-cv-midpoint-pacing-candidate = [
    "fast-route-quantize-fused-v1-candidate",
    "cq-model-deepseek-v4-flash-runtime/fast-cv-midpoint-pacing-candidate",
]
toc-sm70-v1 = [
    "toc-sm70-core-v1",
    "ffn-q1-width2048",
    "fast-route-quantize-fused-v1",
]
# Explicit opt-in product build for retained SM70 decode, qualified V34
# prefill, the 262K owner, and persisted KV8/DSA prefix reuse. The ordinary
# toc-sm70-v1 profile keeps these cache/prefill features disabled; CLI cache
# behavior remains off unless the user selects this alias and a cache mode.
toc-sm70-v1-kv8 = [
    "toc-sm70-v1",
    "cache4-v34-agent-prefix-b16-v3",
    "kv8-dsa-prefix-snapshot",
    "request-mla-long-context-262144",
]
